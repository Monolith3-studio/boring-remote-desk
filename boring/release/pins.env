# Toolchain pins for the local release build (boring/release/build-mac), taken from upstream's
# own workflows so ours builds the same way. boring/pins.py compares them with upstream at a ref
# and --fix rewrites the values here. Sourced by bash: KEY="value", one per line.
# The app version is Cargo.toml's; nothing here repeats it.
FLUTTER_VERSION="3.24.5"
BRIDGE_FLUTTER_VERSION="3.22.3"
FLUTTER_RUST_BRIDGE_VERSION="1.80.1"
CARGO_EXPAND_VERSION="1.0.95"
BRIDGE_RUST_VERSION="1.75"
WIN_RUST_VERSION="1.75"
MAC_RUST_VERSION="1.81"
LLVM_VERSION="15.0.6"
VCPKG_COMMIT_ID="9e593bb18ea69cc5095e012465dcd675a822ed0d"
MIN_MACOS_VERSION="12.3"
DMGBUILD_VERSION="1.6.7"
